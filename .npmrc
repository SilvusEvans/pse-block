# Electron and electron-builder binaries come from npmmirror: GitHub is often unreachable
# from mainland China, and both tools download their toolchains from there.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# Optional: keep npm / electron / electron-builder caches on a project drive instead of the
# user profile. Point these at any writable directory (uncomment and edit):
# cache=<dir>/npm-cache
# electron_cache=<dir>/electron-cache
# electron_builder_cache=<dir>/electron-builder-cache
