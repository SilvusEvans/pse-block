# 贪吃蛇：方向键 / WASD 控制，吃到红点变长，撞墙或咬到自己就结束
# 场地 17×11 网格（格边长 24，格坐标 -8..8 × -5..5）
# 蛇身只用一个列表存：每格编码成 (格x+20)*100 + (格y+20)，查重直接用「列表包含」
# 身体用克隆体画，不用画笔图章：画笔层是位图，图章会把 SVG 造型栅格化掉
# 素材一律 SVG，位图会被 Scratch 重新编码压画质

全局 分数 = 0

角色 蛇:
  造型 "assets/蛇头.svg"
  列表 蛇身
  变量 格子 = 24
  变量 头x = 0
  变量 头y = 0
  变量 dx = 1
  变量 dy = 0
  变量 新dx = 1
  变量 新dy = 0
  变量 食物x = 5
  变量 食物y = 0
  变量 吃到 = 0
  变量 速度 = 0.18

  定义 生成食物 不刷新:
    食物x ← 随机(-8, 8)
    食物y ← 随机(-5, 5)
    重复直到 (非(列表包含(蛇身, (食物x + 20) * 100 + (食物y + 20)))):
      食物x ← 随机(-8, 8)
      食物y ← 随机(-5, 5)

  定义 结束游戏:
    说(连接(连接("游戏结束！得分 ", 分数), "  点绿旗重来"))
    等待 (2)
    停止("全部")

  绿旗:
    显示
    图层位置(最前)
    清空列表(蛇身)
    分数 ← 0
    速度 ← 0.18
    头x ← 0
    头y ← 0
    dx ← 1
    dy ← 0
    新dx ← 1
    新dy ← 0
    加入列表((0 + 20) * 100 + (0 + 20), 蛇身)
    加入列表((-1 + 20) * 100 + (0 + 20), 蛇身)
    加入列表((-2 + 20) * 100 + (0 + 20), 蛇身)
    生成食物()
    移到坐标(头x * 格子, 头y * 格子)
    广播("刷新")
    说等待("方向键控制，吃到红点变长", 1.2)
    重复 永远:
      dx ← 新dx
      dy ← 新dy
      头x ← 头x + dx
      头y ← 头y + dy
      如果 (或(数学(绝对值, 头x) > 8, 数学(绝对值, 头y) > 5)):
        结束游戏()
      吃到 ← 0
      如果 (与(头x = 食物x, 头y = 食物y)):
        吃到 ← 1
      否则:
        删除列表第项("末尾", 蛇身)
      如果 (列表包含(蛇身, (头x + 20) * 100 + (头y + 20))):
        结束游戏()
      插入列表(1, (头x + 20) * 100 + (头y + 20), 蛇身)
      如果 (吃到 = 1):
        分数 ← 分数 + 1
        如果 (速度 > 0.09):
          速度 ← 速度 - 0.01
        生成食物()
      移到坐标(头x * 格子, 头y * 格子)
      广播("刷新")
      等待 (速度)

  当按键按下("上"):
    如果 (dy != -1):
      新dx ← 0
      新dy ← 1

  当按键按下("w"):
    如果 (dy != -1):
      新dx ← 0
      新dy ← 1

  当按键按下("下"):
    如果 (dy != 1):
      新dx ← 0
      新dy ← -1

  当按键按下("s"):
    如果 (dy != 1):
      新dx ← 0
      新dy ← -1

  当按键按下("左"):
    如果 (dx != 1):
      新dx ← -1
      新dy ← 0

  当按键按下("a"):
    如果 (dx != 1):
      新dx ← -1
      新dy ← 0

  当按键按下("右"):
    如果 (dx != -1):
      新dx ← 1
      新dy ← 0

  当按键按下("d"):
    如果 (dx != -1):
      新dx ← 1
      新dy ← 0

角色 蛇身段:
  造型 "assets/身体.svg"
  私有 段号 = 0
  私有 是克隆 = 0
  私有 位置码 = 0

  定义 补足克隆 不刷新:
    重复 (列表长度(蛇身) - 1 - 段号):
      段号 ← 段号 + 1
      克隆自己

  绿旗:
    隐藏
    是克隆 ← 0
    段号 ← 0
    重复 永远:
      补足克隆()
      等待 (0.05)

  当作为克隆体启动时:
    是克隆 ← 1

  当收到("刷新"):
    如果 (与(是克隆 = 1, 段号 + 1 <= 列表长度(蛇身))):
      位置码 ← 列表第项(段号 + 1, 蛇身)
      移到坐标((数学(向下取整, 位置码 / 100) - 20) * 格子, (取余(位置码, 100) - 20) * 格子)
      显示
    否则:
      隐藏

角色 食物:
  造型 "assets/食物.svg"

  绿旗:
    移到坐标(食物x * 格子, 食物y * 格子)

  当收到("刷新"):
    移到坐标(食物x * 格子, 食物y * 格子)

舞台:
  背景 "assets/场地.svg"

  绿旗:
    显示变量(分数)
