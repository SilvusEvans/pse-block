# 列表示例：序号下拉（末尾/随机/全部）、列表内容、遍历与查找
全局 总人数 = 0

角色 点名:
  列表 名单
  变量 i = 0

  绿旗:
    加入列表("小明", 名单)
    加入列表("小红", 名单)
    加入列表("小刚", 名单)
    总人数 ← 列表长度(名单)
    显示列表(名单)
    说(连接("整份名单: ", 列表内容(名单)))
    等待 (1)
    循环计数(i, 总人数):
      说(连接(连接(i, " 号 "), 列表第项(i, 名单)))
      等待 (0.5)
    说(连接("最后一个: ", 列表第项("末尾", 名单)))
    等待 (1)
    说(连接("随机抽中: ", 列表第项("随机", 名单)))
    替换列表("末尾", "小美", 名单)
    插入列表(1, "转学生", 名单)
    如果 (列表包含(名单, "小明")):
      说(连接(连接("小明在第 ", 列表项位置("小明", 名单)), " 位"))
    否则:
      说("名单里没有小明")
    删除列表第项("全部", 名单)
    隐藏列表(名单)
    说("名单已清空")

角色 记录:
  列表 日志
  变量 轮次 = 0

  当收到("点名结束"):
    轮次 ← 轮次 + 1
    加入列表(轮次, 日志)
    说(连接("共记录 ", 列表长度(日志)))

舞台:
  绿旗:
    等待 (2)
    广播("点名结束")
